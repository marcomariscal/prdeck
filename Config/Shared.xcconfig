// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = PRDeck
PRODUCT_DISPLAY_NAME = PRDeck
PRODUCT_BUNDLE_IDENTIFIER = com.marco.PRDeck
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// ==========================================
// Platform Configuration
// ==========================================
MACOSX_DEPLOYMENT_TARGET = 14.0

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

// ==========================================
// Entitlements
// ==========================================
// This app shells out to `gh` and opens URLs; sandboxing breaks access to the user's
// GitHub CLI config/keychain and Homebrew-installed binaries in typical setups.
ENABLE_APP_SANDBOX = NO
CODE_SIGN_ENTITLEMENTS =
